# Dependencias
node_modules

# Variables de entorno
.env

# Logs generados por la aplicación (Módulo 4)
# La carpeta se conserva en el repo (ver logs/.gitkeep) pero NO sus archivos.
logs/*
!logs/.gitkeep

# Sistema
.DS_Store

# Archivos subidos por usuarios (Módulo 7)
# Solo van los metadatos en la BD; los archivos físicos quedan fuera del repo.
uploads/*
!uploads/.gitkeep